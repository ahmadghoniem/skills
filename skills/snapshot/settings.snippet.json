{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy", "Bypass",
              "-File", "C:/Users/YOU/.claude/hooks/load-snapshot.ps1"
            ]
          }
        ]
      }
    ]
  }
}
