{
  "name": "claude-mngr",
  "version": "0.3.0",
  "description": "Manage the Grok, Antigravity, opencode and Codex CLIs from Claude Code, delegate coding tasks to them, and convene them as a review council.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Ahmed Ghoniem",
    "url": "https://github.com/ahmadghoniem"
  },
  "homepage": "https://github.com/ahmadghoniem/skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmadghoniem/skills.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "grok",
    "agy",
    "antigravity",
    "opencode",
    "codex",
    "agent-delegation",
    "council"
  ],
  "engines": {
    "node": ">=18.18",
    "grok": ">=1.0.92",
    "agy": ">=1.5.14",
    "opencode": ">=2.4.1",
    "codex": ">=0.172.0"
  },
  "os": [
    "win32"
  ],
  "files": [
    "plugin.json",
    "commands",
    "scripts",
    "clis",
    "council"
  ],
  "scripts": {
    "test": "vitest run && npm run test:grok && npm run test:agy && npm run test:opencode && npm run test:codex && npm run test:council",
    "test:council": "cd council && vitest run",
    "test:grok": "cd clis/grok && vitest run",
    "test:agy": "cd clis/agy && vitest run",
    "test:opencode": "cd clis/opencode && vitest run",
    "test:codex": "cd clis/codex && vitest run"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
