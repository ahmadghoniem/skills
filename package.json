{
  "name": "ahmadghoniem-skills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ahmed Ghoniem's Claude Code skills and CLI delegation plugins.",
  "license": "MIT",
  "author": {
    "name": "Ahmed Ghoniem",
    "url": "https://github.com/ahmadghoniem"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmadghoniem/skills.git"
  },
  "homepage": "https://github.com/ahmadghoniem/skills",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "npm run test:mngr && npm run test:apply-patch && npm run test:relink",
    "test:mngr": "npm --prefix plugins/mngr test",
    "test:grok": "npm --prefix plugins/mngr run test:grok",
    "test:agy": "npm --prefix plugins/mngr run test:agy",
    "test:opencode": "npm --prefix plugins/mngr run test:opencode",
    "test:codex": "npm --prefix plugins/mngr run test:codex",
    "test:council": "npm --prefix plugins/mngr run test:council",
    "test:apply-patch": "node --test tools/apply-patch/apply-patch.test.mjs tools/apply-patch/bash-guard.test.mjs",
    "test:relink": "node --test tools/relink/relink.test.mjs",
    "relink": "node tools/relink/relink.mjs",
    "install:all": "npm --prefix plugins/mngr ci",
    "validate": "claude plugin validate . --strict"
  }
}
